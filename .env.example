# Copy this file to .env.local and fill in values.
#   cp .env.example .env.local
# NEVER commit .env.local. Only this example file is committed.

# --- Frontend data source ---------------------------------------------------
# true  = pages read fake data from src/mock-data (default while UI is built)
# false = pages read from Supabase (once the backend is connected)
NEXT_PUBLIC_USE_MOCK_DATA=true

# --- Supabase (leave blank until the backend is ready) ----------------------
# Where to find them: Supabase dashboard > Project Settings > API.
# NEXT_PUBLIC_ variables are sent to the browser, so only put public values here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security, so it must NEVER start with
# NEXT_PUBLIC_ and must never be pasted in Discord, GitHub or screenshots.
# Ask the project lead for it only if your ticket needs it.
SUPABASE_SERVICE_ROLE_KEY=
